# OnePlus 13T (PKX110), ColorOS 17, PKX110_17.0.0.104(CN01). Everything the
# build pins lives here. After an OTA, redo the baseline and update this file.

# OnePlus only publishes 16.0.0 sources; the stock build (g9bc34d5b0c79) is not
# public. FINDINGS.md records how this tree differs from the stock kernel.
SOURCE_REPO=https://github.com/OnePlusOSS/android_kernel_common_oneplus_sm8750.git
SOURCE_SHA=4d611c32bedc11cf3ae46aa5e815dfe35707b93f
SOURCE_BRANCH_NOTE=oneplus/sm8750_b_16.0.0_oneplus_13t
EXPECTED_KERNEL_VERSION=6.6.118

# Prebuilt clang r510928, the version named in the stock /proc/version.
CLANG_URL=https://github.com/cctv18/oneplus_sm8650_toolchain/releases/download/LLVM-Clang18-r510928/clang-r510928.zip
CLANG_SHA256=1221635c13d02c5f0c8abb93f38f5d43f5e2f86906ae2e18894ce63e90264164
BUILD_TOOLS_URL=https://github.com/cctv18/oneplus_sm8650_toolchain/releases/download/LLVM-Clang18-r510928/build-tools.zip
BUILD_TOOLS_SHA256=9a1a48cdbaababdfbbec9bee06198c60eb12369188b0f24428fb790c488d00ec

# Unofficial Fengchi (HMBIRD) patch, only used with the workflow's fengchi input.
FENGCHI_PATCH_URL=https://raw.githubusercontent.com/Numbersf/SCHED_PATCH/26e3774a9794e9728a3cc6840f01527de5536eca/fengchi_oneplus_13t_b.patch
FENGCHI_PATCH_SHA256=0f835fea08a94e69409e9b4ffafd97af54c70c9871b25b788cb2eb5dafbbcc97

# Metadata of the stock kernel, so uname -r and /proc/version match it exactly.
STOCK_LOCALVERSION=-android15-8-g9bc34d5b0c79-abogki537459655-4k
STOCK_BUILD_TIMESTAMP="Wed Jul 22 09:32:35 UTC 2026"
STOCK_BUILD_VERSION=1
STOCK_BUILD_USER=kleaf
STOCK_BUILD_HOST=build-host
